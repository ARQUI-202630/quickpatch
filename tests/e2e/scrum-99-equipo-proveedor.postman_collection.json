                "value": "Bearer {{tokenProv1}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/providers/me/technicians?status=inactivo",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "providers",
                "me",
                "technicians?status=inactivo"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('[Filtro status=inactivo] 200 OK y técnico pendiente listado', () => {",
                  "  pm.response.to.have.status(200);",
                  "  const json = pm.response.json();",
                  "  const tech = json.items.find(t => t.email === 'pedro.ramirez.team@quickpatch.test');",
                  "  pm.expect(tech).to.exist;",
                  "  pm.expect(tech.verificationStatus).to.eql('pendiente');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "2.3 Proveedor 1 filtra equipo por status=activo",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Correlation-Id",
                "value": "{{$guid}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{tokenProv1}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/providers/me/technicians?status=activo",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "providers",
                "me",
                "technicians?status=activo"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('[Filtro status=activo] 200 OK y técnico pendiente NO listado como activo', () => {",
                  "  pm.response.to.have.status(200);",
                  "  const json = pm.response.json();",
                  "  const tech = json.items.find(t => t.email === 'pedro.ramirez.team@quickpatch.test');",
                  "  pm.expect(tech).to.be.undefined;",
                  "  pm.expect(json.total).to.eql(0);",
                  "});",
                  "pm.test('[RN-TP1] Solo técnicos aprobados por admin_tenant pueden estar activos', () => {",
                  "  pm.expect(pm.response.json().total).to.eql(0);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3. Validaciones de Negocio y Errores",
      "item": [
        {
          "name": "3.1 Validación: Proveedor envía solicitud incompleta -> 400 Bad Request",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Correlation-Id",
                "value": "{{$guid}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{tokenProv1}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/providers/me/technicians",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "providers",
                "me",
                "technicians"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Incompleto\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('[Validación] 400 Bad Request ante datos faltantes', () => {",
                  "  pm.response.to.have.status(400);",
                  "});",
                  "pm.test('[RFC 9457] Problem Details con correlationId', () => {",
                  "  pm.expect(pm.response.headers.get('Content-Type')).to.include('application/problem+json');",
                  "  pm.expect(pm.response.json()).to.have.property('correlationId');",
                  "});",
                  "pm.test('[Contrato RFC 9457] Tipo de error /validacion-solicitud', () => {",
                  "  pm.expect(pm.response.json().type).to.include('validacion-solicitud');",
                  "});"
                ]
              }
            }
          ]
        },
