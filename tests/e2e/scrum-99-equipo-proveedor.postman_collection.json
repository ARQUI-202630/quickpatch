              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Otro Tecnico\",\n  \"email\": \"otro.correo@quickpatch.test\",\n  \"documentId\": \"CC-987654321\",\n  \"phone\": \"+573101112233\",\n  \"specialtyId\": \"3f1c2a4e-8d7b-4c1a-9e2f-5b6a7c8d9e01\",\n  \"specialty\": \"Plomería\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('[RN-U1] 409 Conflict ante documento de identidad duplicado', () => {",
