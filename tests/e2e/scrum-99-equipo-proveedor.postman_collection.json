    {
      "name": "4. Control de Acceso RBAC y Aislamiento Multi-Tenant",
      "item": [
        {
          "name": "4.1 Control RBAC: Cliente intenta dar de alta técnico en equipo -> 403 Forbidden",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Correlation-Id",
                "value": "{{$guid}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{tokenCliente}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/providers/me/technicians",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "providers",
                "me",
                "technicians"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Intento Ilegal\",\n  \"email\": \"ilegal@quickpatch.test\",\n  \"documentId\": \"CC-777777777\",\n  \"phone\": \"+573100000000\",\n  \"specialtyId\": \"3f1c2a4e-8d7b-4c1a-9e2f-5b6a7c8d9e01\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('[RBAC] 403 Forbidden para cliente intentando gestionar equipo', () => {",
                  "  pm.response.to.have.status(403);",
                  "});",
                  "pm.test('[RFC 9457] Problem Details con correlationId', () => {",
                  "  pm.expect(pm.response.headers.get('Content-Type')).to.include('application/problem+json');",
                  "  pm.expect(pm.response.json()).to.have.property('correlationId');",
                  "});",
                  "pm.test('[Contrato RFC 9457] Tipo de error /no-autorizado', () => {",
                  "  pm.expect(pm.response.json().type).to.include('no-autorizado');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "4.2 Control RBAC: Técnico intenta dar de alta técnico en equipo -> 403 Forbidden",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Correlation-Id",
                "value": "{{$guid}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{tokenTecnico}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/providers/me/technicians",
              "host": [
                "{{baseUrl}}"
              ],
