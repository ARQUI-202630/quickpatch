{
  "info": {
    "_postman_id": "scrum-99-equipo-proveedor-qa",
    "name": "QUICKPATCH — Gestión de Equipo de Técnicos (SCRUM-99 / HU SCRUM-36)",
    "description": "Suite E2E para RF-16, RN-TP3 y RN-TP4: Registro de técnicos en equipo por parte de proveedores, filtros activo/inactivo, unicidad, control RBAC y aislamiento multi-tenant con RLS. QA Lead: Katherine Bravo.",
