    {
      "name": "1. Registro de Técnico en Equipo del Proveedor",
      "item": [
        {
          "name": "1.1 Proveedor 1 registra un técnico en su equipo",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Correlation-Id",
                "value": "{{$guid}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{tokenProv1}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/providers/me/technicians",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "providers",
                "me",
                "technicians"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Pedro Ramirez (Equipo)\",\n  \"email\": \"pedro.ramirez.team@quickpatch.test\",\n  \"documentId\": \"CC-987654321\",\n  \"phone\": \"+573105556677\",\n  \"specialtyId\": \"3f1c2a4e-8d7b-4c1a-9e2f-5b6a7c8d9e01\",\n  \"specialty\": \"Plomería\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('[RN-TP3 / RF-16] 201 Created al dar de alta técnico en equipo', () => {",
                  "  pm.response.to.have.status(201);",
                  "  const json = pm.response.json();",
                  "  pm.expect(json).to.have.property('userId');",
                  "  pm.expect(json.role).to.eql('tecnico');",
                  "  pm.expect(json.verificationStatus).to.eql('pendiente');",
                  "  pm.expect(json.providerId).to.eql('usr-prov-01');",
                  "  pm.expect(json.noticeEmitted).to.eql('technician.registered');",
                  "  pm.collectionVariables.set('teamTechId', json.userId);",
                  "});",
                  "pm.test('[RN-TP3] El técnico hereda estado pendiente y rol técnico', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.verificationStatus).to.eql('pendiente');",
                  "  pm.expect(json.role).to.eql('tecnico');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Consulta y Filtros de Equipo",
      "item": [
        {
          "name": "2.1 Proveedor 1 consulta la lista completa de su equipo",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Correlation-Id",
                "value": "{{$guid}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{tokenProv1}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/providers/me/technicians",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "providers",
                "me",
                "technicians"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('[RN-TP4] 200 OK al consultar equipo de técnicos', () => {",
                  "  pm.response.to.have.status(200);",
                  "  const json = pm.response.json();",
                  "  pm.expect(json).to.have.property('items');",
                  "  pm.expect(json.items).to.be.an('array');",
                  "  pm.expect(json.total).to.be.at.least(1);",
                  "});",
                  "pm.test('[RF-16] Técnico registrado aparece en la lista con datos completos', () => {",
                  "  const json = pm.response.json();",
                  "  const tech = json.items.find(t => t.email === 'pedro.ramirez.team@quickpatch.test');",
                  "  pm.expect(tech).to.exist;",
                  "  pm.expect(tech.fullName).to.eql('Pedro Ramirez (Equipo)');",
                  "  pm.expect(tech.verificationStatus).to.eql('pendiente');",
                  "  pm.expect(tech.providerId).to.eql('usr-prov-01');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "2.2 Proveedor 1 filtra equipo por status=inactivo",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
