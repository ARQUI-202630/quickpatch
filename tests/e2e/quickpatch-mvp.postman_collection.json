{
  "info": {
    "name": "QUICKPATCH — MVP Sprint 3 (flujo de punta a punta)",
    "description": "Administrador crea una categoría (Catalog publica catalog.category-changed) → cliente se registra e inicia sesión (Identity) → crea una solicitud (ServiceRequest valida la categoría en su réplica y publica service-request.created, que consume Matching) → consulta el detalle. Incluye casos negativos de autenticación, rol y cobertura, y la gestión de tenants del administrador de la plataforma (SCRUM-112). Variables: baseUrl (https://qa.quickpatch.internal), adminEmail, adminPassword, platformAdminEmail y platformAdminPassword (secretos de QA, nunca en el repositorio). Contratos: quickpatch-api-gateway/openapi.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://qa.quickpatch.internal"
    },
    {
      "key": "adminEmail",
      "value": ""
    },
    {
      "key": "adminPassword",
      "value": ""
    },
    {
      "key": "platformAdminEmail",
      "value": ""
    },
    {
      "key": "platformAdminPassword",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Administrador del tenant",
      "item": [
        {
          "name": "Login del administrador",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Correlation-Id",
                "value": "{{$guid}}"
              },
              {
                "key": "X-Channel-Id",
                "value": "quickpatch-mobile"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 con token', () => pm.response.to.have.status(200));",
                  "const r = pm.response.json();",
                  "pm.test('rol admin_tenant', () => pm.expect(r.user.role).to.eql('admin_tenant'));",
                  "pm.collectionVariables.set('adminToken', r.accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Crear categoría",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Correlation-Id",
                "value": "{{$guid}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/catalog/admin/categories",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "catalog",
                "admin",
                "categories"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Plomería {{sufijo}}\",\n  \"description\": \"Fugas, grifería y tuberías\"\n}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('sufijo', Date.now().toString(36));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 creada y activa', () => {",
                  "  pm.response.to.have.status(201);",
                  "  pm.expect(pm.response.json().active).to.eql(true);",
                  "});",
                  "pm.collectionVariables.set('categoriaId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Categoría con nombre repetido → 409",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Correlation-Id",
                "value": "{{$guid}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/catalog/admin/categories",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "catalog",
                "admin",
                "categories"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Plomería {{sufijo}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('409 categoría registrada', () => pm.response.to.have.status(409));",
                  "pm.test('Problem Details (RFC 9457) con correlationId', () => {",
                  "  pm.expect(pm.response.headers.get('Content-Type')).to.include('application/problem+json');",
                  "  pm.expect(pm.response.json()).to.have.property('correlationId');",
                  "});"
                ]
              }
            }
          ]
        }
