    {
      "name": "4. Límite documentado: una calle de Bogotá con otra ciudad escrita (SRS 2.3.1)",
      "item": [
        {
          "name": "LÍMITE: una calle de Bogotá con Medellín escrita se ubica en Bogotá (Suba)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Correlation-Id",
                "value": "{{$guid}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{clienteToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/service-requests/location-preview",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "service-requests",
                "location-preview"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"addressText\": \"Carrera 70 # 44-50, Laureles, Medellín\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 con punto dentro del área de cobertura de Bogotá', () => {",
                  "  pm.response.to.have.status(200);",
                  "  const r = pm.response.json();",
                  "  pm.expect(r.location.latitude).to.be.within(4.45, 4.85);",
                  "  pm.expect(r.location.longitude).to.be.within(-74.25, -73.98);",
                  "  pm.expect(r.matchedAddress).to.include('Bogotá');",
                  "  pm.expect(r.locality.name).to.eql('Suba');",
                  "});"
                ]
              }
            }
          ]
        },
