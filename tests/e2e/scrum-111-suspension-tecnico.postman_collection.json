    {
      "name": "1. Suspensión y Reactivación de Técnico",
      "item": [
        {
          "name": "1.1 Admin suspende técnico en estado aprobado",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Correlation-Id",
                "value": "{{$guid}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{tokenAdmin}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/admin/technicians/usr-tec-approved-01/suspend",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "admin",
                "technicians",
                "usr-tec-approved-01",
                "suspend"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Incumplimiento grave reiterado de protocolos de seguridad.\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('[RF-20 / RN-TP2] 200 OK al suspender técnico aprobado con motivo válido', () => {",
                  "  pm.response.to.have.status(200);",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.userId).to.eql('usr-tec-approved-01');",
                  "  pm.expect(json.verificationStatus).to.eql('suspendido');",
                  "  pm.expect(json.reason).to.include('Incumplimiento grave');",
                  "  pm.expect(json.matchingBlocked).to.be.true;",
                  "  pm.expect(json).to.have.property('suspendedAt');",
                  "  pm.expect(json.suspendedBy).to.eql('usr-admin-01');",
                  "  pm.expect(json.noticeEmitted).to.eql('technician.verification-changed');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "1.2 Admin consulta técnicos suspendidos",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Correlation-Id",
                "value": "{{$guid}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{tokenAdmin}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/admin/technicians?verificationStatus=suspendido",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "admin",
                "technicians?verificationStatus=suspendido"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('[Consistencia] Técnico suspendido aparece en lista de suspendidos', () => {",
                  "  pm.response.to.have.status(200);",
                  "  const json = pm.response.json();",
                  "  const found = json.items.find(t => t.userId === 'usr-tec-approved-01');",
                  "  pm.expect(found).to.exist;",
                  "  pm.expect(found.verificationStatus).to.eql('suspendido');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "1.3 Reactivación: Admin aprueba y reactiva técnico suspendido (usr-tec-suspended-01)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Correlation-Id",
                "value": "{{$guid}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{tokenAdmin}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/admin/technicians/usr-tec-suspended-01/approve",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "admin",
                "technicians",
                "usr-tec-suspended-01",
                "approve"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('[Reactivación / DD §8.3.13] 200 OK al reactivar técnico suspendido a aprobado', () => {",
                  "  pm.response.to.have.status(200);",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.userId).to.eql('usr-tec-suspended-01');",
                  "  pm.expect(json.verificationStatus).to.eql('aprobado');",
                  "  pm.expect(json.noticeEmitted).to.eql('technician.verification-changed');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Reglas de Negocio y Validaciones",
      "item": [
        {
          "name": "2.1 Validación: Intento de suspender con motivo menor a 5 caracteres -> 400 Bad Request",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Correlation-Id",
                "value": "{{$guid}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{tokenAdmin}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/admin/technicians/usr-tec-approved-01/suspend",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "admin",
                "technicians",
                "usr-tec-approved-01",
                "suspend"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"mal\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('[Validación] 400 Bad Request cuando el motivo de suspensión es < 5 caracteres', () => {",
                  "  pm.response.to.have.status(400);",
                  "});",
                  "pm.test('[RFC 9457] Problem Details con correlationId', () => {",
                  "  pm.expect(pm.response.headers.get('Content-Type')).to.include('application/problem+json');",
                  "  pm.expect(pm.response.json()).to.have.property('correlationId');",
                  "});",
                  "pm.test('[Contrato RFC 9457] Tipo de error /validacion-solicitud', () => {",
                  "  pm.expect(pm.response.json().type).to.include('validacion-solicitud');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "2.2 Transición Inválida: Intento de suspender técnico ya suspendido -> 409 Conflict",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Correlation-Id",
                "value": "{{$guid}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{tokenAdmin}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/admin/technicians/usr-tec-approved-01/suspend",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "admin",
                "technicians",
                "usr-tec-approved-01",
                "suspend"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Intento de re-suspensión no admitido\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('[Transición Inválida] 409 Conflict al intentar suspender un técnico ya suspendido', () => {",
                  "  pm.response.to.have.status(409);",
                  "});",
                  "pm.test('[RFC 9457] Problem Details con correlationId', () => {",
                  "  pm.expect(pm.response.headers.get('Content-Type')).to.include('application/problem+json');",
                  "  pm.expect(pm.response.json()).to.have.property('correlationId');",
                  "});",
                  "pm.test('[Contrato RFC 9457] Tipo de error /transicion-invalida', () => {",
                  "  pm.expect(pm.response.json().type).to.include('transicion-invalida');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "2.3 Transición Inválida: Intento de suspender técnico en estado pendiente -> 409 Conflict",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Correlation-Id",
                "value": "{{$guid}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{tokenAdmin}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/admin/technicians/usr-tec-pending-01/suspend",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "admin",
                "technicians",
                "usr-tec-pending-01",
                "suspend"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"No se puede suspender quien no ha sido previamente aprobado\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('[Transición Inválida] 409 Conflict al intentar suspender un técnico en estado pendiente', () => {",
                  "  pm.response.to.have.status(409);",
                  "});",
                  "pm.test('[RFC 9457] Problem Details con correlationId', () => {",
                  "  pm.expect(pm.response.headers.get('Content-Type')).to.include('application/problem+json');",
                  "  pm.expect(pm.response.json()).to.have.property('correlationId');",
                  "});",
                  "pm.test('[Contrato RFC 9457] Tipo de error /transicion-invalida', () => {",
                  "  pm.expect(pm.response.json().type).to.include('transicion-invalida');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3. Control de Acceso RBAC y Aislamiento Multi-Tenant",
      "item": [
        {
          "name": "3.1 Control RBAC: Cliente intenta suspender técnico -> 403 Forbidden",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Correlation-Id",
                "value": "{{$guid}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{tokenCliente}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/admin/technicians/usr-tec-approved-01/suspend",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "admin",
                "technicians",
                "usr-tec-approved-01",
                "suspend"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Cliente inconforme con servicio\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('[RBAC] 403 Forbidden para cliente intentando suspender técnico', () => {",
                  "  pm.response.to.have.status(403);",
                  "});",
                  "pm.test('[RFC 9457] Problem Details con correlationId', () => {",
                  "  pm.expect(pm.response.headers.get('Content-Type')).to.include('application/problem+json');",
                  "  pm.expect(pm.response.json()).to.have.property('correlationId');",
                  "});",
                  "pm.test('[Contrato RFC 9457] Tipo de error /no-autorizado', () => {",
                  "  pm.expect(pm.response.json().type).to.include('no-autorizado');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "3.2 Control RBAC: Técnico intenta suspender a colega -> 403 Forbidden",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Correlation-Id",
                "value": "{{$guid}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{tokenTecnico}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/admin/technicians/usr-tec-approved-01/suspend",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "admin",
                "technicians",
                "usr-tec-approved-01",
                "suspend"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Conflicto operativo entre técnicos\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('[RBAC] 403 Forbidden para técnico intentando suspender a otro técnico', () => {",
                  "  pm.response.to.have.status(403);",
                  "});",
                  "pm.test('[RFC 9457] Problem Details con correlationId', () => {",
                  "  pm.expect(pm.response.headers.get('Content-Type')).to.include('application/problem+json');",
                  "  pm.expect(pm.response.json()).to.have.property('correlationId');",
                  "});",
                  "pm.test('[Contrato RFC 9457] Tipo de error /no-autorizado', () => {",
                  "  pm.expect(pm.response.json().type).to.include('no-autorizado');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "3.3 Seguridad: Solicitud anónima sin token -> 401 Unauthorized",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Correlation-Id",
                "value": "{{$guid}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/admin/technicians/usr-tec-approved-01/suspend",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "admin",
                "technicians",
                "usr-tec-approved-01",
                "suspend"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Petición anónima ilegal\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('[Seguridad] 401 Unauthorized ante solicitud anónima de suspensión (IDN-017)', () => {",
                  "  pm.response.to.have.status(401);",
                  "});",
                  "pm.test('[RFC 9457] Problem Details con correlationId', () => {",
                  "  pm.expect(pm.response.headers.get('Content-Type')).to.include('application/problem+json');",
                  "  pm.expect(pm.response.json()).to.have.property('correlationId');",
                  "});",
                  "pm.test('[Contrato RFC 9457] Tipo de error /no-autenticado', () => {",
                  "  pm.expect(pm.response.json().type).to.include('no-autenticado');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "3.4 Aislamiento Multi-Tenant (RLS): Admin Beta intenta suspender técnico de Alfa -> 404 Not Found",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Correlation-Id",
                "value": "{{$guid}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{tokenAdminBeta}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/admin/technicians/usr-tec-approved-01/suspend",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "admin",
                "technicians",
                "usr-tec-approved-01",
                "suspend"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Suspensión cross-tenant no permitida\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('[SAD AC6-E2 / RLS] 404 Not Found para Admin Beta intentando suspender técnico de Alfa', () => {",
                  "  pm.response.to.have.status(404);",
                  "});",
                  "pm.test('[RFC 9457] Problem Details con correlationId', () => {",
                  "  pm.expect(pm.response.headers.get('Content-Type')).to.include('application/problem+json');",
                  "  pm.expect(pm.response.json()).to.have.property('correlationId');",
                  "});",
                  "pm.test('[Contrato RFC 9457] Tipo de error /no-encontrado', () => {",
                  "  pm.expect(pm.response.json().type).to.include('no-encontrado');",
                  "});"
                ]
              }
            }
          ]
