          "name": "2.1 Creación de solicitud por cliente (estado inicial buscando_tecnico)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Correlation-Id",
                "value": "{{$guid}}"
              },
              {
                "key": "X-Channel-Id",
                "value": "quickpatch-mobile"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{clienteToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/service-requests",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "service-requests"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"sr-tracking-01\",\n  \"categoryId\": \"3f1c2a4e-8d7b-4c1a-9e2f-5b6a7c8d9e01\",\n  \"description\": \"Fuga de tubería principal en cocina\",\n  \"location\": {\n    \"latitude\": 4.6533,\n    \"longitude\": -74.0836\n  },\n  \"addressText\": \"Carrera 15 # 85-30, apto 401\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('[ServiceRequest] 201 Created para nueva solicitud', () => pm.response.to.have.status(201));",
                  "pm.test('[SCRUM-31] Estado inicial es buscando_tecnico', () => pm.expect(pm.response.json().status).to.eql('buscando_tecnico'));",
                  "pm.collectionVariables.set('requestId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "2.2 Cliente consulta estado inicial de su solicitud",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Correlation-Id",
                "value": "{{$guid}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{clienteToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/service-requests/{{requestId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "service-requests",
                "{{requestId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('[Seguimiento] 200 OK en consulta de solicitud', () => pm.response.to.have.status(200));",
                  "pm.test('[Estado 1] Solicitud visible en estado buscando_tecnico', () => pm.expect(pm.response.json().status).to.eql('buscando_tecnico'));",
                  "pm.test('[Cliente] Técnico es null antes de la asignación', () => pm.expect(pm.response.json().technician).to.be.null);"
                ]
              }
            }
          ]
        }
      ]
    },
