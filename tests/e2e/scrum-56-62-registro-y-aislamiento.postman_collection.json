                "register",
                "technician"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"invalido@quickpatch.test\",\n  \"password\": \"123\",\n  \"fullName\": \"Técnico Inválido\",\n  \"role\": \"tecnico\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('[SCRUM-56] 400 Bad Request por fallo de validación de contrato', () => pm.response.to.have.status(400));",
                  "pm.test('[RFC 9457] Problem Details con correlationId', () => {",
                  "  pm.expect(pm.response.headers.get('Content-Type')).to.include('application/problem+json');",
                  "  pm.expect(pm.response.json()).to.have.property('correlationId');",
                  "});",
                  "pm.test('[Contrato] Tipo de error validacion-solicitud', () => pm.expect(pm.response.json().type).to.match(/\\/validacion-solicitud$/));"
                ]
              }
            }
          ]
        },
        {
          "name": "1.5 Login de técnico registrado y obtención de JWT",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Correlation-Id",
                "value": "{{$guid}}"
              },
              {
                "key": "X-Channel-Id",
                "value": "quickpatch-mobile"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"tecnico@quickpatch.test\",\n  \"password\": \"PasswordTecnico123*\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('[Auth] Login de técnico exitoso (200 OK)', () => pm.response.to.have.status(200));",
                  "pm.test('[RBAC] Rol del usuario es tecnico', () => pm.expect(pm.response.json().user.role).to.eql('tecnico'));",
                  "pm.collectionVariables.set('tecnicoToken', pm.response.json().accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "1.6 Consulta de perfil propio (/v1/users/me) con verificationStatus",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Correlation-Id",
                "value": "{{$guid}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{tecnicoToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/users/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "users",
                "me"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('[SCRUM-56] 200 OK en consulta de perfil', () => pm.response.to.have.status(200));",
                  "pm.test('[SCRUM-56] verificationStatus visible como pendiente', () => pm.expect(pm.response.json().verificationStatus).to.eql('pendiente'));",
                  "pm.test('[SCRUM-56] Rol verificado como tecnico', () => pm.expect(pm.response.json().role).to.eql('tecnico'));"
                ]
              }
            }
          ]
        },
        {
          "name": "1.7 Control RBAC: Técnico no puede crear solicitudes de cliente → 403 Forbidden",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Correlation-Id",
                "value": "{{$guid}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{tecnicoToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/service-requests",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "service-requests"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"categoryId\": \"3f1c2a4e-8d7b-4c1a-9e2f-5b6a7c8d9e01\",\n  \"description\": \"Fuga de agua intentada por técnico\",\n  \"location\": {\n    \"latitude\": 4.6533,\n    \"longitude\": -74.0836\n  },\n  \"addressText\": \"Calle 45 # 13-20\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('[RBAC / IDN-012] 403 Forbidden para rol tecnico creando solicitud', () => pm.response.to.have.status(403));",
                  "pm.test('[RFC 9457] Problem Details con correlationId', () => {",
                  "  pm.expect(pm.response.headers.get('Content-Type')).to.include('application/problem+json');",
                  "  pm.expect(pm.response.json()).to.have.property('correlationId');",
                  "});",
                  "pm.test('[Contrato] Tipo de error no-autorizado', () => pm.expect(pm.response.json().type).to.match(/\\/no-autorizado$/));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. SCRUM-62 — Aislamiento Lógico de Datos por Tenant (Multi-tenant RLS)",
      "item": [
        {
          "name": "2.1 Login de Cliente en Tenant Alfa",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Correlation-Id",
                "value": "{{$guid}}"
              },
              {
                "key": "X-Channel-Id",
                "value": "quickpatch-mobile"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"cliente.alfa@quickpatch.test\",\n  \"password\": \"PasswordCliente123*\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('[Tenant Alfa] Login exitoso', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('tokenAlfa', pm.response.json().accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "2.2 Creación de Solicitud de Servicio en Tenant Alfa",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Correlation-Id",
                "value": "{{$guid}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{tokenAlfa}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/service-requests",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "service-requests"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"categoryId\": \"3f1c2a4e-8d7b-4c1a-9e2f-5b6a7c8d9e01\",\n  \"description\": \"Fuga de tubería principal exclusiva Tenant Alfa\",\n  \"location\": {\n    \"latitude\": 4.6533,\n    \"longitude\": -74.0836\n  },\n  \"addressText\": \"Carrera 7 # 72-10\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('[Tenant Alfa] Solicitud creada con éxito (201 Created)', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('solicitudAlfaId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "2.3 Login de Cliente en Tenant Beta",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Correlation-Id",
                "value": "{{$guid}}"
              },
              {
                "key": "X-Channel-Id",
                "value": "quickpatch-mobile"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"cliente.beta@quickpatch.test\",\n  \"password\": \"PasswordCliente123*\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('[Tenant Beta] Login exitoso con credenciales de Tenant Beta', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('tokenBeta', pm.response.json().accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "2.4 Verificación de Fuga Cross-Tenant (Tenant Beta consulta solicitud de Tenant Alfa) → 404 Not Found",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Correlation-Id",
                "value": "{{$guid}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{tokenBeta}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/service-requests/{{solicitudAlfaId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "service-requests",
                "{{solicitudAlfaId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('[SCRUM-62 / RLS] Código 404 Not Found (cero fuga de datos cross-tenant)', () => pm.response.to.have.status(404));",
                  "pm.test('[Seguridad] Cuerpo no expone datos de la orden de Tenant Alfa', () => {",
                  "  pm.expect(pm.response.text()).to.not.include('exclusiva Tenant Alfa');",
                  "});",
                  "pm.test('[RFC 9457] Problem Details con correlationId', () => {",
                  "  pm.expect(pm.response.headers.get('Content-Type')).to.include('application/problem+json');",
                  "  pm.expect(pm.response.json()).to.have.property('correlationId');",
                  "});",
                  "pm.test('[Contrato] Tipo de error no-encontrado', () => pm.expect(pm.response.json().type).to.match(/\\/no-encontrado$/));"
                ]
              }
            }
          ]
        },
        {
          "name": "2.5 Aislamiento en Catálogo: Tenant Beta no ve categorías de Tenant Alfa",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Correlation-Id",
                "value": "{{$guid}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{tokenBeta}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/catalog/categories",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "catalog",
                "categories"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('[SCRUM-62] Catálogo responde 200 OK para Tenant Beta', () => pm.response.to.have.status(200));",
                  "pm.test('[Aislamiento Catálogo] Categoría exclusiva de Alfa no es visible en Beta', () => {",
                  "  const nombres = pm.response.json().map(c => c.name);",
                  "  pm.expect(nombres).to.not.include('Plomería Exclusiva Alfa');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "2.6 Control Positivo: Propietario en Tenant Alfa sí consulta su solicitud",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Correlation-Id",
                "value": "{{$guid}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{tokenAlfa}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/service-requests/{{solicitudAlfaId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "service-requests",
                "{{solicitudAlfaId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('[Tenant Alfa] 200 OK para el cliente propietario en su mismo tenant', () => pm.response.to.have.status(200));",
                  "pm.test('[Consistencia] Retorna la misma solicitud creada en el paso 2.2', () => {",
                  "  pm.expect(pm.response.json().id).to.eql(pm.collectionVariables.get('solicitudAlfaId'));",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
