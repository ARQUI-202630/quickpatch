                "type": "text/javascript",
                "exec": [
                  "pm.test('[Auth] Login de Técnico para Control RBAC exitoso (200 OK)', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('tokenTecnico', pm.response.json().accessToken);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "1. Asignación Automática y Verificación de SLA (RN-M9, RNF-05, RF-09)",
      "item": [
        {
          "name": "1.1 Creación de solicitud con candidato elegible → Estado asignado",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Correlation-Id",
                "value": "{{$guid}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{tokenAlfa}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/service-requests",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "service-requests"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"categoryId\": \"3f1c2a4e-8d7b-4c1a-9e2f-5b6a7c8d9e01\",\n  \"description\": \"Fuga urgente en tubería principal — asignación requerida\",\n  \"location\": {\n    \"latitude\": 4.6533,\n    \"longitude\": -74.0836\n  },\n  \"addressText\": \"Carrera 7 # 45-10\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) { pm.collectionVariables.set('solicitudAsignadaId', pm.response.json().id); }",
                  "pm.test('[RF-09 / RN-M9] Solicitud creada y técnico asignado automáticamente (201 Created)', () => {",
                  "  pm.response.to.have.status(201);",
                  "  const res = pm.response.json();",
                  "  pm.expect(res.status).to.eql('asignado');",
                  "  pm.expect(res.technicianId).to.eql('usr-tec-approved-01');",
                  "  pm.expect(res.assignedAt).to.not.be.null;",
                  "});",
                  "pm.test('[RNF-05 / AC2-E3] SLA: Tiempo de primer intento de asignación < 60 segundos', () => {",
                  "  pm.expect(pm.response.responseTime).to.be.below(60000);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "1.2 Consulta de Intentos de Matching y Evaluación de Candidatos",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Correlation-Id",
                "value": "{{$guid}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{tokenAlfa}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/matching/attempts/{{solicitudAsignadaId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "matching",
                "attempts",
                "{{solicitudAsignadaId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('[SCRUM-78] 200 OK en historial de matching_attempts', () => pm.response.to.have.status(200));",
                  "pm.test('[Matching Engine] Se registró intento de matching con resultado asignado', () => {",
                  "  const res = pm.response.json();",
                  "  pm.expect(res.attemptCount).to.be.at.least(1);",
                  "  pm.expect(res.status).to.eql('asignado');",
                  "});",
                  "pm.test('[RN-M9] Candidato seleccionado es un técnico aprobado y disponible', () => {",
                  "  const evalData = pm.response.json().candidateEvaluation;",
                  "  pm.expect(evalData.eligibleCandidateAssigned).to.eql('usr-tec-approved-01');",
                  "});",
                  "pm.test('[RNF-05] Duración del intento de matching medida dentro del SLA (< 60.000 ms)', () => {",
                  "  pm.expect(pm.response.json().firstAttemptDurationMs).to.be.below(60000);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Exclusión de Candidatos No Elegibles y Estado En Espera (RN-M9, RN-M10, RF-10)",
      "item": [
        {
          "name": "2.1 Solicitud sin candidatos elegibles → Estado en_espera (RN-M10)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Correlation-Id",
                "value": "{{$guid}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{tokenAlfa}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/service-requests",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "service-requests"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"categoryId\": \"3f1c2a4e-8d7b-4c1a-9e2f-5b6a7c8d9e01\",\n  \"description\": \"Fuga sin_candidatos disponibles en zona periférica rural\",\n  \"location\": {\n    \"latitude\": 4.85,\n    \"longitude\": -74.05\n  },\n  \"addressText\": \"Zona Rural Norte Km 14\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) { pm.collectionVariables.set('solicitudEnEsperaId', pm.response.json().id); }",
                  "pm.test('[RF-10 / RN-M10] Solicitud creada pasa a en_espera por falta de candidatos (201 Created)', () => {",
                  "  pm.response.to.have.status(201);",
                  "  const res = pm.response.json();",
                  "  pm.expect(res.status).to.eql('en_espera');",
                  "  pm.expect(res.technicianId).to.be.null;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "2.2 Detalle de Solicitud en_espera no expone asignación previa",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Correlation-Id",
                "value": "{{$guid}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{tokenAlfa}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/service-requests/{{solicitudEnEsperaId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "service-requests",
                "{{solicitudEnEsperaId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('[Consistencia] 200 OK en consulta de solicitud en espera', () => pm.response.to.have.status(200));",
                  "pm.test('[RN-M10] Solicitud permanece en_espera de nuevo técnico disponible', () => {",
                  "  const res = pm.response.json();",
                  "  pm.expect(res.status).to.eql('en_espera');",
                  "  pm.expect(res.technicianId).to.be.null;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "2.3 Auditoría de Intentos: Técnicos pendientes y fuera de zona descartados",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Correlation-Id",
                "value": "{{$guid}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{tokenAlfa}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/matching/attempts/{{solicitudEnEsperaId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "matching",
                "attempts",
                "{{solicitudEnEsperaId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('[Matching Engine] 200 OK en intentos de solicitud en espera', () => pm.response.to.have.status(200));",
                  "pm.test('[RN-M9] Técnicos pendientes y fuera de cobertura fueron excluidos', () => {",
                  "  const evalData = pm.response.json().candidateEvaluation;",
                  "  pm.expect(evalData.excludedNotApproved).to.be.at.least(1);",
                  "  pm.expect(evalData.excludedOutOfCoverage).to.be.at.least(1);",
                  "  pm.expect(evalData.eligibleCandidateAssigned).to.be.null;",
                  "});",
                  "pm.test('[Estado] Resultado global de matching es sin_candidatos', () => {",
                  "  pm.expect(pm.response.json().status).to.eql('sin_candidatos');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3. Idempotencia del Consumidor de Eventos (processed_events / AC5-E5)",
      "item": [
        {
          "name": "3.1 Primer consumo del evento service-request.created",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Correlation-Id",
                "value": "{{$guid}}"
              },
              {
                "key": "X-Event-Id",
                "value": "{{eventIdPrueba}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/matching/events/simulate-event",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "matching",
                "events",
                "simulate-event"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"isDuplicate\": false,\n  \"serviceRequestId\": \"{{solicitudAsignadaId}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('eventIdPrueba', 'evt-' + Date.now());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('[Idempotencia / AC5-E5] Evento procesado exitosamente por primera vez (200 OK)', () => pm.response.to.have.status(200));",
                  "pm.test('[processed_events] Resultado registrado es APPLIED_FIRST_TIME', () => {",
                  "  pm.expect(pm.response.json().idempotentOutcome).to.eql('APPLIED_FIRST_TIME');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "3.2 Reenvío duplicado del mismo evento → Descartado sin reprocesamiento",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Correlation-Id",
                "value": "{{$guid}}"
              },
              {
                "key": "X-Event-Id",
                "value": "{{eventIdPrueba}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/matching/events/simulate-event",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "matching",
                "events",
                "simulate-event"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"isDuplicate\": true,\n  \"serviceRequestId\": \"{{solicitudAsignadaId}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('[Idempotencia] Reenvío duplicado responde 200 OK sin fallar', () => pm.response.to.have.status(200));",
                  "pm.test('[processed_events] Detección de duplicado: SKIPPED_ALREADY_PROCESSED', () => {",
                  "  const res = pm.response.json();",
                  "  pm.expect(res.idempotentOutcome).to.eql('SKIPPED_ALREADY_PROCESSED');",
                  "  pm.expect(res.duplicateHandledGracefully).to.be.true;",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "4. Control de Acceso RBAC y Seguridad (IDN-017, RFC 9457)",
      "item": [
        {
          "name": "4.1 Control RBAC: Rol Técnico intenta crear solicitud de servicio → 403 Forbidden",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Correlation-Id",
                "value": "{{$guid}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{tokenTecnico}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/service-requests",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "service-requests"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"categoryId\": \"3f1c2a4e-8d7b-4c1a-9e2f-5b6a7c8d9e01\",\n  \"description\": \"Intento no autorizado de técnico\",\n  \"location\": {\n    \"latitude\": 4.6533,\n    \"longitude\": -74.0836\n  }\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('[RBAC / IDN-012] 403 Forbidden para rol técnico creando solicitudes', () => pm.response.to.have.status(403));",
                  "pm.test('[RFC 9457] Problem Details con correlationId', () => {",
                  "  pm.expect(pm.response.headers.get('Content-Type')).to.include('application/problem+json');",
                  "  pm.expect(pm.response.json()).to.have.property('correlationId');",
                  "});",
                  "pm.test('[Contrato RFC 9457] Tipo de error /no-autorizado', () => pm.expect(pm.response.json().type).to.match(/\\/no-autorizado$/));"
                ]
              }
            }
          ]
        },
        {
          "name": "4.2 Seguridad: Solicitud anónima de creación sin token → 401 Unauthorized",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Correlation-Id",
                "value": "{{$guid}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/service-requests",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "service-requests"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"categoryId\": \"3f1c2a4e-8d7b-4c1a-9e2f-5b6a7c8d9e01\",\n  \"description\": \"Intento anónimo sin token\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('[Seguridad / IDN-017] 401 Unauthorized ante creación anónima', () => pm.response.to.have.status(401));",
                  "pm.test('[RFC 9457] Problem Details con correlationId', () => {",
                  "  pm.expect(pm.response.headers.get('Content-Type')).to.include('application/problem+json');",
                  "  pm.expect(pm.response.json()).to.have.property('correlationId');",
                  "});",
                  "pm.test('[Contrato RFC 9457] Tipo de error /no-autenticado', () => pm.expect(pm.response.json().type).to.match(/\\/no-autenticado$/));"
                ]
