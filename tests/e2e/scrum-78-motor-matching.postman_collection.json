    {
      "name": "1. Elegibilidad, Cobertura y Disponibilidad del Motor (RN-M9, RF-13)",
      "item": [
        {
          "name": "1.1 Catálogo de 20 Localidades Oficiales de Bogotá (RF-13, RN-M9)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Correlation-Id",
                "value": "{{$guid}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/localities",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "localities"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('[Matching Engine] 200 OK en catálogo de localidades', () => pm.response.to.have.status(200));",
                  "pm.test('[RN-M9 / RF-13] Catálogo contiene las 20 localidades oficiales de Bogotá', () => {",
                  "  const locs = pm.response.json();",
                  "  pm.expect(locs).to.be.an('array');",
                  "  pm.expect(locs.length).to.be.at.least(20);",
                  "  pm.collectionVariables.set('codigosLocalidades', JSON.stringify(locs.slice(0, 5).map(l => l.code)));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "1.2 Consulta de Disponibilidad del Técnico (RF-13)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Correlation-Id",
                "value": "{{$guid}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{tokenTecnico}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/technicians/me/availability",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "technicians",
                "me",
                "availability"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('[Matching Engine] 200 OK en consulta de disponibilidad', () => pm.response.to.have.status(200));",
                  "pm.test('[RF-13] Estado de disponibilidad retornado correctamente', () => {",
                  "  const res = pm.response.json();",
                  "  pm.expect(res).to.have.property('status');",
                  "  pm.expect(['disponible', 'no_disponible', 'ocupado']).to.include(res.status);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "1.3 Configuración de Cobertura Geográfica del Técnico (RF-13, RN-M9)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Correlation-Id",
                "value": "{{$guid}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{tokenTecnico}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/technicians/me/coverage",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "technicians",
                "me",
                "coverage"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"localityCodes\": [\n    \"01\",\n    \"02\",\n    \"03\",\n    \"04\",\n    \"05\"\n  ]\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('[Matching Engine] 200 OK al actualizar cobertura geográfica', () => pm.response.to.have.status(200));",
                  "pm.test('[RN-M9] Cobertura registrada exitosamente', () => {",
                  "  const res = pm.response.json();",
                  "  const codes = (res.localities || []).map(l => l.code);",
                  "  pm.expect(codes).to.include.members(['01', '02']);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "1.4 Transición de Disponibilidad del Técnico a Disponible (RF-13)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Correlation-Id",
                "value": "{{$guid}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{tokenTecnico}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/technicians/me/availability",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "technicians",
                "me",
                "availability"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"disponible\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('[Matching Engine] 200 OK al actualizar disponibilidad', () => pm.response.to.have.status(200));",
                  "pm.test('[RF-13] Técnico pasa a estado disponible', () => {",
                  "  pm.expect(pm.response.json().status).to.eql('disponible');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Creación de Solicitud y SLA de Matching (RN-M9, RNF-05, RF-09, RN-M10)",
      "item": [
        {
          "name": "2.1 Creación de solicitud con candidato elegible (SLA < 60s)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Correlation-Id",
                "value": "{{$guid}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{tokenAlfa}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/service-requests",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "service-requests"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"categoryId\": \"{{categoriaId}}\",\n  \"description\": \"Fuga urgente en tubería principal — asignación requerida de matching\",\n  \"location\": {\n    \"latitude\": 4.6533,\n    \"longitude\": -74.0836\n  },\n  \"addressText\": \"Carrera 7 # 45-10, Chapinero\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('[RF-09 / RN-M9] Solicitud creada exitosamente (201 Created)', () => {",
                  "  pm.response.to.have.status(201);",
                  "  const res = pm.response.json();",
                  "  pm.collectionVariables.set('solicitudAsignadaId', res.id);",
                  "  pm.expect(['buscando_tecnico', 'asignado', 'en_espera']).to.include(res.status);",
                  "});",
                  "pm.test('[RNF-05 / AC2-E3] SLA: Tiempo de primer intento de matching < 60 segundos', () => {",
                  "  pm.expect(pm.response.responseTime).to.be.below(60000);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "2.2 Consulta de Solicitud por el Cliente Dueño",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Correlation-Id",
                "value": "{{$guid}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{tokenAlfa}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/service-requests/{{solicitudAsignadaId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "service-requests",
                "{{solicitudAsignadaId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('[ServiceRequest] 200 OK en consulta de solicitud', () => pm.response.to.have.status(200));",
                  "pm.test('[Consistencia] Solicitud creada mantiene identificador y ciclo de vida de matching', () => {",
                  "  const res = pm.response.json();",
                  "  pm.expect(res.id).to.eql(pm.collectionVariables.get('solicitudAsignadaId'));",
                  "  pm.expect(['buscando_tecnico', 'asignado', 'en_espera']).to.include(res.status);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "2.3 Solicitud en zona periférica → Búsqueda y gestión en espera (RN-M10)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Correlation-Id",
                "value": "{{$guid}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{tokenAlfa}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/service-requests",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "service-requests"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"categoryId\": \"{{categoriaId}}\",\n  \"description\": \"Fuga sin candidatos inmediatos en el extremo norte de Usaquén (periferia)\",\n  \"location\": {\n    \"latitude\": 4.76,\n    \"longitude\": -74.03\n  },\n  \"addressText\": \"Extremo norte de Usaquén, Torca\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('[RF-10 / RN-M10] Solicitud periférica creada exitosamente (201 Created)', () => {",
                  "  pm.response.to.have.status(201);",
                  "  const res = pm.response.json();",
                  "  pm.collectionVariables.set('solicitudEnEsperaId', res.id);",
                  "  pm.expect(['buscando_tecnico', 'en_espera', 'asignado']).to.include(res.status);",
                  "});",
                  "pm.test('[RNF-05] SLA de creación y evaluación espacial < 60.000 ms', () => {",
                  "  pm.expect(pm.response.responseTime).to.be.below(60000);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "2.4 Detalle de Solicitud periférica no expone asignación previa errónea",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Correlation-Id",
                "value": "{{$guid}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{tokenAlfa}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/service-requests/{{solicitudEnEsperaId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "service-requests",
                "{{solicitudEnEsperaId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('[Consistencia] 200 OK en consulta de solicitud periférica', () => pm.response.to.have.status(200));",
