    {
      "name": "3. Tenant reactivado: la creación deja de responder tenant-inactivo",
      "item": [
        {
          "name": "El administrador de la plataforma reactiva Beta",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Correlation-Id",
                "value": "{{$guid}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{plataformaToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/platform/tenants/{{betaId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
