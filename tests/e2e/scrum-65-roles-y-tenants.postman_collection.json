  "item": [
    {
      "name": "SCRUM-65 — Roles y Permisos (RBAC)",
      "description": "Pruebas de validación de control de acceso por roles (RF-05, AC6-E3). Se evalúan rechazos 403 Forbidden ante operaciones fuera del alcance del rol asignado y formato de error RFC 9457.",
      "item": [
        {
          "name": "IDN-011: [Cliente -> Admin Endpoint] Rechazo 403 al crear tenant",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token_cliente}}",
                "type": "text"
              },
              {
                "key": "X-Correlation-Id",
                "value": "{{correlationId}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Empresa No Autorizada S.A.\",\n  \"nit\": \"901999888-1\",\n  \"contactEmail\": \"contacto@no-autorizado.com\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/admin/tenants",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "admin",
                "tenants"
              ]
            },
            "description": "Verifica que un usuario autenticado con rol 'cliente' no pueda ejecutar operaciones reservadas al rol 'admin' (creación o administración de tenants)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Validación de código de estado HTTP 403 Forbidden",
                  "pm.test('[SCRUM-65 / IDN-011] Código de respuesta es 403 Forbidden', function () {",
                  "    pm.response.to.have.status(403);",
                  "});",
                  "",
                  "// Validación de estructura RFC 9457 (ProblemDetails)",
                  "pm.test('[SCRUM-65] Estructura ProblemDetails válida con status 403', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.status).to.eql(403);",
                  "    pm.expect(json).to.have.property('title');",
                  "});",
                  "",
                  "// Verificación de correlación para auditoría de seguridad en logs",
                  "pm.test('[SCRUM-65] Header de correlación recibido en la respuesta', function () {",
                  "    pm.expect(pm.response.headers.has('X-Correlation-Id') || pm.response.headers.has('x-correlation-id')).to.be.true;",
                  "});"
                ]
              }
            }
          ]
        },
        {
