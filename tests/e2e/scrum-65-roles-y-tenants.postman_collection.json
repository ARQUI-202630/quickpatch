            },
            "url": {
              "raw": "{{baseUrl}}/v1/service-requests",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "service-requests"
              ]
            },
            "description": "Criterio principal de aceptación de SCRUM-114: la API rechaza la creación de solicitudes si el tenant está desactivado (RN-T1, IDN-019)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('[SCRUM-114 / E2E-004] Rechazo 403 Forbidden para creación de solicitud con tenant inactivo', function () {",
                  "    pm.expect([403, 422]).to.include(pm.response.code);",
                  "});",
                  "",
                  "pm.test('[SCRUM-114] Respuesta describe bloqueo por tenant inactivo', function () {",
                  "    var text = pm.response.text().toLowerCase();",
                  "    var valid = text.includes('tenant') && (text.includes('disabled') || text.includes('inactivo') || text.includes('suspendido'));",
                  "    pm.expect(valid).to.be.true;",
                  "});"
                ]
              }
            }
          ]
        },
