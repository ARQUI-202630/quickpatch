              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "service-requests"
              ]
            },
            "description": "Caso de control positivo: confirma que un cliente legítimo con tenant activo no experimenta rechazos 401 ni 403 de tenant o RBAC."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('[SCRUM-114] Cliente con tenant activo no recibe 401 Unauthorized ni 403 Forbidden', function () {",
                  "    pm.expect(pm.response.code).to.not.equal(401);",
                  "    pm.expect(pm.response.code).to.not.equal(403);",
                  "});"
                ]
              }
