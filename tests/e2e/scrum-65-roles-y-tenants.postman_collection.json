{
  "info": {
    "_postman_id": "c6a1b820-8e34-4b52-9c17-123456789abc",
    "name": "QUICKPATCH - Pruebas de Roles, Permisos y Tenants (SCRUM-65 / SCRUM-114)",
    "description": "Suite automatizada de pruebas de API para la compuerta de seguridad y autorización multi-tenant.\n\nCubre:\n- SCRUM-65 (RF-05, AC6-E3): Control de acceso por roles (RBAC) y rechazo 403 con ProblemDetails.\n- SCRUM-114 (RF-21, RN-T1): Aislamiento y restricción de tenants inactivos/desactivados.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Generador dinámico de Correlation ID para trazabilidad en logs (IDN-016)",
          "if (!pm.collectionVariables.get('correlationId')) {",
          "    var uuid = 'qa-' + Date.now() + '-' + Math.floor(Math.random() * 10000);",
          "    pm.collectionVariables.set('correlationId', uuid);",
          "}",
          "",
          "// Funciones utilitarias para generación de tokens sintéticos con roles y estados de tenant",
          "function base64url(source) {",
          "    var encodedSource = CryptoJS.enc.Base64.stringify(source);",
          "    encodedSource = encodedSource.replace(/=+$/, '');",
          "    encodedSource = encodedSource.replace(/\\+/g, '-');",
          "    encodedSource = encodedSource.replace(/\\//g, '_');",
          "    return encodedSource;",
          "}",
          "",
          "function buildJwt(payload) {",
          "    var header = { alg: 'HS256', typ: 'JWT' };",
          "    var strHeader = base64url(CryptoJS.enc.Utf8.parse(JSON.stringify(header)));",
          "    var strPayload = base64url(CryptoJS.enc.Utf8.parse(JSON.stringify(payload)));",
          "    var secret = pm.variables.get('jwtSecret') || 'quickpatch-qa-secret-key-2026';",
          "    var signature = base64url(CryptoJS.HmacSHA256(strHeader + '.' + strPayload, secret));",
          "    return strHeader + '.' + strPayload + '.' + signature;",
          "}",
          "",
          "var now = Math.floor(Date.now() / 1000);",
          "var exp = now + 7200; // 2 horas",
          "var tenantActivo = pm.variables.get('activeTenantId') || 'a1a1a1a1-bbbb-cccc-dddd-eeeeeeeeeeee';",
          "var tenantInactivo = pm.variables.get('disabledTenantId') || 'd9d9d9d9-0000-1111-2222-333333333333';",
          "",
          "// Token para rol Cliente (Tenant Activo)",
          "var tokenCliente = buildJwt({ sub: 'usr-client-001', role: 'cliente', tenant_id: tenantActivo, exp: exp });",
          "pm.variables.set('token_cliente', tokenCliente);",
          "",
          "// Token para rol Tecnico (Tenant Activo)",
          "var tokenTecnico = buildJwt({ sub: 'usr-tech-001', role: 'tecnico', tenant_id: tenantActivo, exp: exp });",
          "pm.variables.set('token_tecnico', tokenTecnico);",
          "",
          "// Token para rol Administrador (Tenant Activo)",
          "var tokenAdmin = buildJwt({ sub: 'usr-admin-001', role: 'admin', tenant_id: tenantActivo, exp: exp });",
          "pm.variables.set('token_admin', tokenAdmin);",
          "",
          "// Token para usuario perteneciente a un Tenant Desactivado/Inactivo",
          "var tokenTenantInactivo = buildJwt({ sub: 'usr-disabled-tenant', role: 'cliente', tenant_id: tenantInactivo, tenant_status: 'inactivo', exp: exp });",
          "pm.variables.set('token_tenant_desactivado', tokenTenantInactivo);"
        ]
      }
    }
  ],
