{
  "info": {
    "name": "QUICKPATCH — Roles, Permisos y Tenants (SCRUM-65, SCRUM-114)",
    "description": "Suite automatizada de pruebas de API para validación de control de acceso por roles (RBAC) y restricciones de ciclo de vida de tenants (SCRUM-65, SCRUM-114, RF-05, RF-21, RN-T1, AC6-E3).\n\nDiseñada para ejecutarse en el runner de CI/CD de QA (VM1) o en local mediante Newman.\nVariables: baseUrl (default: https://qa.quickpatch.internal), adminEmail y adminPassword (provistos como variables de entorno del runner, nunca versionados).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://qa.quickpatch.internal"
    },
    {
      "key": "adminEmail",
      "value": ""
    },
    {
      "key": "adminPassword",
      "value": ""
    },
    {
      "key": "sufijo",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Autenticación y Semillas de Prueba",
      "description": "Obtención de tokens RS256 legítimos desde Identity Service para cada rol (ADR-018).",
      "item": [
        {
          "name": "1.1 Login Administrador de Tenant (Identity)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Correlation-Id",
                "value": "{{$guid}}"
              },
              {
                "key": "X-Channel-Id",
                "value": "quickpatch-mobile"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('[Auth] Login de administrador exitoso (200 OK)', () => {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "if (pm.response.code === 200) {",
                  "  var resAdmin = pm.response.json();",
                  "  pm.test('[RBAC] Rol verificado como admin_tenant', () => {",
                  "    pm.expect(resAdmin.user.role).to.eql('admin_tenant');",
                  "  });",
                  "  pm.collectionVariables.set('adminToken', resAdmin.accessToken);",
                  "  pm.collectionVariables.set('sufijo', Date.now().toString(36));",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "1.2 Crear Categoría de Servicio (Catalog)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Correlation-Id",
                "value": "{{$guid}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/catalog/admin/categories",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "catalog",
                "admin",
                "categories"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Plomería QA {{sufijo}}\",\n  \"description\": \"Servicios de plomería para pruebas\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('[Catalog] Categoría creada exitosamente (201 Created)', () => {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "if (pm.response.code === 201) {",
                  "  pm.collectionVariables.set('categoriaId', pm.response.json().id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "1.3 Registro de Usuario con Rol Cliente",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Correlation-Id",
                "value": "{{$guid}}"
              },
              {
                "key": "X-Channel-Id",
                "value": "quickpatch-mobile"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/register/client",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "register",
                "client"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"cliente.qa.{{sufijo}}@quickpatch.test\",\n  \"password\": \"PasswordSeguro123*\",\n  \"fullName\": \"Cliente QA Automatizado\",\n  \"phone\": \"3109876543\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('[Auth] Registro de cliente exitoso (201 Created)', () => {",
                  "  pm.response.to.have.status(201);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "1.4 Login de Usuario Cliente",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Correlation-Id",
                "value": "{{$guid}}"
              },
              {
                "key": "X-Channel-Id",
                "value": "quickpatch-mobile"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"cliente.qa.{{sufijo}}@quickpatch.test\",\n  \"password\": \"PasswordSeguro123*\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('[Auth] Login de cliente exitoso (200 OK)', () => {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "if (pm.response.code === 200) {",
                  "  var resCli = pm.response.json();",
                  "  pm.test('[RBAC] Rol verificado como cliente', () => {",
                  "    pm.expect(resCli.user.role).to.eql('cliente');",
                  "  });",
                  "  pm.collectionVariables.set('clienteToken', resCli.accessToken);",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. SCRUM-65 — Control de Acceso por Roles (RBAC)",
      "description": "Pruebas de acceso no autorizado (403) por cada combinación de rol/endpoint restringido y 401 para peticiones no autenticadas.",
      "item": [
        {
          "name": "2.1 [IDN-012] Administrador intentando crear solicitud → 403 Forbidden",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Correlation-Id",
                "value": "{{$guid}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/service-requests",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "service-requests"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"categoryId\": \"{{categoriaId}}\",\n  \"description\": \"Intento de creación de solicitud por usuario administrador\",\n  \"location\": {\n    \"latitude\": 4.6533,\n    \"longitude\": -74.0836\n  },\n  \"addressText\": \"Calle 45 # 13-20, Bogotá D.C.\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('[SCRUM-65 / IDN-012] Código 403 Forbidden para rol admin creando solicitud', () => {",
                  "  pm.response.to.have.status(403);",
                  "});",
                  "pm.test('[SCRUM-65] Tipo de error no-autorizado según contrato', () => {",
                  "  pm.expect(pm.response.json().type).to.include('/problems/no-autorizado');",
                  "});",
                  "pm.test('[RFC 9457] Content-Type es application/problem+json', () => {",
                  "  pm.expect(pm.response.headers.get('Content-Type')).to.include('application/problem+json');",
                  "});",
                  "pm.test('[Auditoría] correlationId presente en el cuerpo de error', () => {",
                  "  pm.expect(pm.response.json()).to.have.property('correlationId');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "2.2 [CAT-010] Cliente intentando crear categoría administrativa → 403 Forbidden",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Correlation-Id",
                "value": "{{$guid}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{clienteToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/catalog/admin/categories",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "catalog",
                "admin",
                "categories"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Categoría No Autorizada {{sufijo}}\",\n  \"description\": \"Intento de mutación por cliente\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('[SCRUM-65 / CAT-010] Código 403 Forbidden para cliente mutando catálogo', () => {",
                  "  pm.response.to.have.status(403);",
                  "});",
                  "pm.test('[SCRUM-65] Tipo de error no-autorizado según contrato', () => {",
                  "  pm.expect(pm.response.json().type).to.include('/problems/no-autorizado');",
                  "});",
                  "pm.test('[RFC 9457] Content-Type es application/problem+json', () => {",
                  "  pm.expect(pm.response.headers.get('Content-Type')).to.include('application/problem+json');",
                  "});",
                  "pm.test('[Auditoría] correlationId presente en el cuerpo de error', () => {",
                  "  pm.expect(pm.response.json()).to.have.property('correlationId');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "2.3 [IDN-017] Petición anónima sin token → 401 Unauthorized",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Correlation-Id",
                "value": "{{$guid}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/service-requests",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "service-requests"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"categoryId\": \"{{categoriaId}}\",\n  \"description\": \"Petición anónima sin credenciales\",\n  \"location\": {\n    \"latitude\": 4.6533,\n    \"longitude\": -74.0836\n  },\n  \"addressText\": \"Calle 45 # 13-20, Bogotá D.C.\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('[SCRUM-65 / IDN-017] Código 401 Unauthorized ante petición anónima', () => {",
                  "  pm.response.to.have.status(401);",
                  "});",
                  "pm.test('[SCRUM-65] Tipo de error no-autenticado según contrato', () => {",
                  "  pm.expect(pm.response.json().type).to.include('/problems/no-autenticado');",
                  "});",
                  "pm.test('[RFC 9457] Content-Type es application/problem+json', () => {",
                  "  pm.expect(pm.response.headers.get('Content-Type')).to.include('application/problem+json');",
                  "});",
                  "pm.test('[Auditoría] correlationId presente en el cuerpo de error', () => {",
                  "  pm.expect(pm.response.json()).to.have.property('correlationId');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3. SCRUM-114 — Gestión y Ciclo de Vida de Tenants",
      "description": "Pruebas de restricción para tenants inactivos/desactivados según RN-T1 y DD 7.12.",
      "item": [
        {
          "name": "3.1 [IDN-019 / E2E-004] Rechazo de autenticación para usuario de tenant inactivo",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Correlation-Id",
                "value": "{{$guid}}"
              },
              {
                "key": "X-Channel-Id",
                "value": "quickpatch-mobile"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"inactivo@tenant-suspendido.test\",\n  \"password\": \"PasswordInactivo123*\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// RN-T1 y DD 7.12 (IDN-019) queda PENDIENTE en el MVP: el login usa el tenant del canal (RN-U5), que es el de la",
                  "// plataforma y no se puede desactivar (409), y este usuario no existe, así que no hay un tenant inactivo que probar.",
                  "// Se podrá probar con un segundo tenant de prueba (SCRUM-41). Mientras tanto se comprueba lo que sí está especificado:",
                  "// un login con credenciales que no existen responde 401 en Problem Details sin revelar si el correo existe.",
                  "pm.test.skip('[SCRUM-114 / IDN-019] Login rechazado para tenant inactivo (403): pendiente de SCRUM-41, el MVP tiene un solo tenant', () => {",
                  "  pm.response.to.have.status(403);",
                  "});",
                  "pm.test('[SCRUM-114] Credenciales inexistentes: 401', () => {",
                  "  pm.response.to.have.status(401);",
                  "});",
                  "pm.test('[SCRUM-114] Problem Details (RFC 9457) con correlationId y tipo credenciales-invalidas', () => {",
                  "  pm.expect(pm.response.headers.get('Content-Type')).to.include('application/problem+json');",
                  "  const cuerpo = pm.response.json();",
                  "  pm.expect(cuerpo.type).to.include('credenciales-invalidas');",
                  "  pm.expect(cuerpo.correlationId).to.be.ok;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "3.2 [TEN-001] Control positivo: Creación de solicitud por cliente de tenant activo",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Correlation-Id",
                "value": "{{$guid}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{clienteToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/service-requests",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "service-requests"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"categoryId\": \"{{categoriaId}}\",\n  \"description\": \"Fuga de agua en lavaplatos para cliente activo\",\n  \"location\": {\n    \"latitude\": 4.6533,\n    \"longitude\": -74.0836\n  },\n  \"addressText\": \"Calle 45 # 13-20, apto 301, Bogotá D.C.\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Manejo de réplica asíncrona de categorías por eventos (ADR-017):",
                  "const intento = Number(pm.collectionVariables.get('retryCount') || 0);",
                  "if (pm.response.code === 422 && intento < 8) {",
                  "  pm.collectionVariables.set('retryCount', intento + 1);",
                  "  setTimeout(() => {}, 2000);",
                  "  postman.setNextRequest(pm.info.requestName);",
                  "} else {",
                  "  pm.collectionVariables.unset('retryCount');",
                  "  pm.test('[SCRUM-114 / TEN-001] Solicitud creada exitosamente (201 Created)', () => {",
                  "    pm.response.to.have.status(201);",
                  "  });",
                  "  pm.test('[SCRUM-114] Estado inicial en buscando_tecnico', () => {",
                  "    pm.expect(pm.response.json().status).to.eql('buscando_tecnico');",
                  "  });",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
