    {
      "name": "SCRUM-114 — Gestión de Tenants (Tenant Desactivado)",
      "description": "Pruebas del ciclo de vida y aislamiento de tenants (RF-21, RN-T1, AC8-E1). Valida que un tenant en estado inactivo/desactivado no pueda iniciar sesión ni crear solicitudes de servicio.",
      "item": [
        {
          "name": "IDN-019: [Login Tenant Inactivo] Rechazo de autenticación para tenant deshabilitado",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Correlation-Id",
                "value": "{{correlationId}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"usuario@tenant-inactivo.com\",\n  \"password\": \"PasswordSeguro2026*\",\n  \"tenantId\": \"{{disabledTenantId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "auth",
                "login"
              ]
            },
            "description": "Verifica que las credenciales pertenecientes a un tenant suspendido o inactivo no permitan inicio de sesión (RN-T1)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('[SCRUM-114 / IDN-019] Login denegado para tenant inactivo (403 o 422)', function () {",
                  "    pm.expect([401, 403, 422]).to.include(pm.response.code);",
                  "});",
                  "",
                  "pm.test('[SCRUM-114] Detalle de error indica estado del tenant', function () {",
                  "    var text = pm.response.text().toLowerCase();",
                  "    var valid = text.includes('disabled') || text.includes('desactivado') || text.includes('inactivo') || text.includes('tenant');",
                  "    pm.expect(valid).to.be.true;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "E2E-004: [Crear Solicitud con Tenant Inactivo] Bloqueo 403 de nuevas solicitudes",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token_tenant_desactivado}}",
