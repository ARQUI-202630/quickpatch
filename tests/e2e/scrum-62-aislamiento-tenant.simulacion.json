{
  "info": {
    "name": "QUICKPATCH — Aislamiento por Tenant (SCRUM-62 / Simulación RLS)",
    "description": "Suite de simulación arquitectónica para SCRUM-62 (Aislamiento Lógico de Datos por Tenant):\nValida que las reglas de negocio y políticas de Row-Level Security (RLS) eviten cualquier fuga\nde información entre empresas oferentes (Tenant Alfa vs Tenant Beta).\nNota: En el release de QA real, el aislamiento se valida mediante las pruebas de integración\ncon PostgreSQL real (IDN-009, IDN-010, CAT-004, SRQ-007) mientras se habilita el multi-tenant público (SCRUM-41).\nVariables: baseUrl (http://localhost:8080 en simulador local).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "clienteAlfaEmail",
      "value": "cliente.alfa@quickpatch.test",
      "type": "string"
    },
    {
      "key": "clienteAlfaPassword",
      "value": "",
      "type": "string"
    },
    {
      "key": "clienteBetaEmail",
      "value": "cliente.beta@quickpatch.test",
      "type": "string"
    },
    {
      "key": "clienteBetaPassword",
      "value": "",
      "type": "string"
    },
    {
      "key": "tokenAlfa",
      "value": "",
      "type": "string"
    },
    {
      "key": "tokenBeta",
      "value": "",
      "type": "string"
    },
    {
      "key": "solicitudAlfaId",
      "value": "sr-qa-001",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "SCRUM-62 — Aislamiento Lógico de Datos por Tenant (Simulación RLS)",
      "item": [
        {
          "name": "1. Login de Cliente en Tenant Alfa",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Correlation-Id",
                "value": "{{$guid}}"
              },
              {
                "key": "X-Channel-Id",
                "value": "quickpatch-mobile"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{clienteAlfaEmail}}\",\n  \"password\": \"{{clienteAlfaPassword}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('[Tenant Alfa] Login exitoso', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('tokenAlfa', pm.response.json().accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "2. Creación de Solicitud de Servicio en Tenant Alfa",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Correlation-Id",
                "value": "{{$guid}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{tokenAlfa}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/service-requests",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "service-requests"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"categoryId\": \"3f1c2a4e-8d7b-4c1a-9e2f-5b6a7c8d9e01\",\n  \"description\": \"Fuga de tubería principal exclusiva Tenant Alfa\",\n  \"location\": {\n    \"latitude\": 4.6533,\n    \"longitude\": -74.0836\n  },\n  \"addressText\": \"Carrera 7 # 72-10\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('[Tenant Alfa] Solicitud creada con éxito (201 Created)', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('solicitudAlfaId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "3. Login de Cliente en Tenant Beta",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Correlation-Id",
                "value": "{{$guid}}"
              },
              {
                "key": "X-Channel-Id",
                "value": "quickpatch-mobile"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{clienteBetaEmail}}\",\n  \"password\": \"{{clienteBetaPassword}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('[Tenant Beta] Login exitoso con credenciales de Tenant Beta', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('tokenBeta', pm.response.json().accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "4. Verificación de Fuga Cross-Tenant (Tenant Beta consulta solicitud de Tenant Alfa) → 404 Not Found",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Correlation-Id",
                "value": "{{$guid}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{tokenBeta}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/service-requests/{{solicitudAlfaId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "service-requests",
                "{{solicitudAlfaId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('[SCRUM-62 / RLS] Código 404 Not Found (cero fuga de datos cross-tenant)', () => pm.response.to.have.status(404));",
                  "pm.test('[Seguridad] Cuerpo no expone datos de la orden de Tenant Alfa', () => {",
                  "  pm.expect(pm.response.text()).to.not.include('exclusiva Tenant Alfa');",
                  "});",
                  "pm.test('[RFC 9457] Problem Details con correlationId', () => {",
                  "  pm.expect(pm.response.headers.get('Content-Type')).to.include('application/problem+json');",
                  "  pm.expect(pm.response.json()).to.have.property('correlationId');",
                  "});",
                  "pm.test('[Contrato] Tipo de error no-encontrado', () => pm.expect(pm.response.json().type).to.match(/\\/no-encontrado$/));"
                ]
              }
            }
          ]
        },
        {
          "name": "5. Aislamiento en Catálogo: Tenant Beta no ve categorías de Tenant Alfa",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Correlation-Id",
                "value": "{{$guid}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{tokenBeta}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/catalog/categories",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "catalog",
                "categories"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('[SCRUM-62] Catálogo responde 200 OK para Tenant Beta', () => pm.response.to.have.status(200));",
                  "pm.test('[Aislamiento Catálogo] Categoría exclusiva de Alfa no es visible en Beta', () => {",
                  "  const nombres = pm.response.json().map(c => c.name);",
                  "  pm.expect(nombres).to.not.include('Plomería Exclusiva Alfa');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "6. Control Positivo: Propietario en Tenant Alfa sí consulta su solicitud",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Correlation-Id",
                "value": "{{$guid}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{tokenAlfa}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/service-requests/{{solicitudAlfaId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "service-requests",
                "{{solicitudAlfaId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('[Tenant Alfa] 200 OK para el cliente propietario en su mismo tenant', () => pm.response.to.have.status(200));",
                  "pm.test('[Consistencia] Retorna la misma solicitud creada en el paso 2', () => {",
                  "  pm.expect(pm.response.json().id).to.eql(pm.collectionVariables.get('solicitudAlfaId'));",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
