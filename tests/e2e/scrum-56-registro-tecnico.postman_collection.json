{
  "info": {
    "name": "QUICKPATCH — Registro y Perfil de Técnico (SCRUM-56)",
    "description": "Suite automatizada de pruebas de sistema (E2E) para SCRUM-56 (Identity Service):\nValida el flujo completo de registro de técnicos y proveedores bajo contratos OpenAPI identity.v1.yaml.\nCompatible con ejecución en QA real y en simulador local.\nVariables: baseUrl (https://qa.quickpatch.internal o http://localhost:8080), adminEmail, adminPassword.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "adminEmail",
      "value": "",
      "type": "string"
    },
    {
      "key": "adminPassword",
      "value": "",
      "type": "string"
    },
    {
      "key": "tecnicoPassword",
      "value": "",
      "type": "string"
    },
    {
      "key": "specialtyId",
      "value": "3f1c2a4e-8d7b-4c1a-9e2f-5b6a7c8d9e01",
      "type": "string"
    },
    {
      "key": "documentoTecnico",
      "value": "",
      "type": "string"
    },
    {
      "key": "correoTecnico",
      "value": "",
      "type": "string"
    },
    {
      "key": "tecnicoToken",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "0. Semillas y Datos de Referencia",
      "item": [
        {
          "name": "0.1 Obtener Especialidad Real de Catálogo",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Correlation-Id",
                "value": "{{$guid}}"
              },
              {
                "key": "X-Channel-Id",
                "value": "quickpatch-mobile"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/catalog/categories",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "catalog",
                "categories"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('[Catalog] 200 OK en consulta de categorías activas', () => pm.response.to.have.status(200));",
                  "const categories = pm.response.json();",
                  "pm.test('[Catalog] Existe al menos una categoría en el tenant', () => pm.expect(categories.length).to.be.above(0));",
                  "if (categories && categories.length > 0) {",
                  "  pm.collectionVariables.set('specialtyId', categories[0].id);",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "1. SCRUM-56 — Registro y Perfil de Técnico (Identity)",
      "item": [
        {
          "name": "1.1 Registro exitoso de técnico (verificationStatus: pendiente)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Correlation-Id",
                "value": "{{$guid}}"
              },
              {
                "key": "X-Channel-Id",
                "value": "quickpatch-mobile"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/register/technician",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "register",
                "technician"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{correoTecnico}}\",\n  \"password\": \"{{tecnicoPassword}}\",\n  \"fullName\": \"Carlos Alberto Técnico QA\",\n  \"phone\": \"3109876543\",\n  \"documentId\": \"{{documentoTecnico}}\",\n  \"specialtyId\": \"{{specialtyId}}\",\n  \"role\": \"tecnico\"\n}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const ts = Date.now();",
                  "const doc = String(ts).slice(-8);",
                  "pm.collectionVariables.set('documentoTecnico', doc);",
                  "pm.collectionVariables.set('correoTecnico', 'tecnico.' + ts + '@quickpatch.test');",
                  "pm.collectionVariables.set('tecnicoPassword', 'Qp_' + ts + '_Tec9!');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('[SCRUM-56] 201 Created para registro legítimo', () => pm.response.to.have.status(201));",
                  "pm.test('[SCRUM-56] Rol verificado como tecnico', () => pm.expect(pm.response.json().role).to.eql('tecnico'));",
                  "pm.test('[SCRUM-56 / RN-U1] verificationStatus inicial es pendiente', () => pm.expect(pm.response.json().verificationStatus).to.eql('pendiente'));",
                  "pm.test('[Auditoría] Correlation ID presente en cabecera', () => pm.expect(pm.response.headers.get('X-Correlation-Id')).to.not.be.empty);"
                ]
              }
            }
          ]
        },
        {
          "name": "1.2 Rechazo por documento de identidad repetido → 409 Conflict",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Correlation-Id",
                "value": "{{$guid}}"
              },
              {
                "key": "X-Channel-Id",
                "value": "quickpatch-mobile"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/register/technician",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "register",
                "technician"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{otroCorreo}}\",\n  \"password\": \"{{tecnicoPassword}}\",\n  \"fullName\": \"Intento Duplicado Documento\",\n  \"phone\": \"3112223344\",\n  \"documentId\": \"{{documentoTecnico}}\",\n  \"specialtyId\": \"{{specialtyId}}\",\n  \"role\": \"tecnico\"\n}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('otroCorreo', 'otro.' + Date.now() + '@quickpatch.test');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('[SCRUM-56] 409 Conflict ante documento repetido', () => pm.response.to.have.status(409));",
                  "pm.test('[RFC 9457] Problem Details con correlationId', () => {",
                  "  pm.expect(pm.response.headers.get('Content-Type')).to.include('application/problem+json');",
                  "  pm.expect(pm.response.json()).to.have.property('correlationId');",
                  "});",
                  "pm.test('[Contrato] Tipo de error documento-registrado', () => pm.expect(pm.response.json().type).to.match(/\\/documento-registrado$/));"
                ]
              }
            }
          ]
        },
        {
          "name": "1.3 Rechazo por correo electrónico repetido → 409 Conflict",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Correlation-Id",
                "value": "{{$guid}}"
              },
              {
                "key": "X-Channel-Id",
                "value": "quickpatch-mobile"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/register/technician",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "register",
                "technician"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{correoTecnico}}\",\n  \"password\": \"{{tecnicoPassword}}\",\n  \"fullName\": \"Intento Duplicado Correo\",\n  \"phone\": \"3119998877\",\n  \"documentId\": \"{{otroDocumento}}\",\n  \"specialtyId\": \"{{specialtyId}}\",\n  \"role\": \"tecnico\"\n}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('otroDocumento', String(Date.now() + 1).slice(-8));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('[SCRUM-56] 409 Conflict ante correo repetido', () => pm.response.to.have.status(409));",
                  "pm.test('[RFC 9457] Problem Details con correlationId', () => {",
                  "  pm.expect(pm.response.headers.get('Content-Type')).to.include('application/problem+json');",
                  "  pm.expect(pm.response.json()).to.have.property('correlationId');",
                  "});",
                  "pm.test('[Contrato] Tipo de error correo-registrado', () => pm.expect(pm.response.json().type).to.match(/\\/correo-registrado$/));"
                ]
              }
            }
          ]
        },
        {
          "name": "1.4 Rechazo por documento ausente / clave corta → 400 Bad Request",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Correlation-Id",
                "value": "{{$guid}}"
              },
              {
                "key": "X-Channel-Id",
                "value": "quickpatch-mobile"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/register/technician",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "register",
                "technician"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"invalido@quickpatch.test\",\n  \"password\": \"123\",\n  \"fullName\": \"Técnico Inválido\",\n  \"role\": \"tecnico\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('[SCRUM-56] 400 Bad Request por fallo de validación de contrato', () => pm.response.to.have.status(400));",
                  "pm.test('[RFC 9457] Problem Details con correlationId', () => {",
                  "  pm.expect(pm.response.headers.get('Content-Type')).to.include('application/problem+json');",
                  "  pm.expect(pm.response.json()).to.have.property('correlationId');",
                  "});",
                  "pm.test('[Contrato] Tipo de error validacion', () => pm.expect(pm.response.json().type).to.match(/\\/validacion$/));"
                ]
              }
            }
          ]
        },
        {
          "name": "1.5 Login de técnico registrado y obtención de JWT",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Correlation-Id",
                "value": "{{$guid}}"
              },
              {
                "key": "X-Channel-Id",
                "value": "quickpatch-mobile"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{correoTecnico}}\",\n  \"password\": \"{{tecnicoPassword}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('[Auth] Login de técnico registrado exitoso (200 OK)', () => pm.response.to.have.status(200));",
                  "pm.test('[RBAC] Rol del usuario es tecnico', () => pm.expect(pm.response.json().user.role).to.eql('tecnico'));",
                  "pm.collectionVariables.set('tecnicoToken', pm.response.json().accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "1.6 Consulta de perfil propio (/v1/users/me) con verificationStatus",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Correlation-Id",
                "value": "{{$guid}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{tecnicoToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/users/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "users",
                "me"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('[SCRUM-56] 200 OK en consulta de perfil', () => pm.response.to.have.status(200));",
                  "pm.test('[SCRUM-56] verificationStatus visible como pendiente', () => pm.expect(pm.response.json().verificationStatus).to.eql('pendiente'));",
                  "pm.test('[SCRUM-56] Rol verificado como tecnico', () => pm.expect(pm.response.json().role).to.eql('tecnico'));"
                ]
              }
            }
          ]
        },
        {
          "name": "1.7 Control RBAC: Técnico no puede crear solicitudes de cliente → 403 Forbidden",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Correlation-Id",
                "value": "{{$guid}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{tecnicoToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/service-requests",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "service-requests"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"categoryId\": \"{{specialtyId}}\",\n  \"description\": \"Fuga de agua intentada por técnico\",\n  \"location\": {\n    \"latitude\": 4.6533,\n    \"longitude\": -74.0836\n  },\n  \"addressText\": \"Calle 45 # 13-20\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('[RBAC / IDN-012] 403 Forbidden para rol tecnico creando solicitud', () => pm.response.to.have.status(403));",
                  "pm.test('[RFC 9457] Problem Details con correlationId', () => {",
                  "  pm.expect(pm.response.headers.get('Content-Type')).to.include('application/problem+json');",
                  "  pm.expect(pm.response.json()).to.have.property('correlationId');",
                  "});",
                  "pm.test('[Contrato] Tipo de error no-autorizado', () => pm.expect(pm.response.json().type).to.match(/\\/no-autorizado$/));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
