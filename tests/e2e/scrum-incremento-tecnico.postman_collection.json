{
  "info": {
    "name": "QUICKPATCH — Incremento Técnico (SCRUM-81, SCRUM-90, SCRUM-93)",
    "description": "Suite automatizada de pruebas de sistema (E2E) para el incremento del técnico (Sprint 4):\n- SCRUM-90: Disponibilidad y cobertura geográfica (Matching Service / HU SCRUM-33)\n- SCRUM-81: Aceptación y rechazo de ofertas de asignación (Matching Service / HU SCRUM-30)\n- SCRUM-93: Detalle de solicitud para técnico asignado (ServiceRequest Service / HU SCRUM-34)\nValida contratos OpenAPI matching.v1.yaml y service-request.v1.yaml con RFC 9457.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "tecnicoEmail",
      "value": "tecnico@quickpatch.test",
      "type": "string"
    },
    {
      "key": "tecnicoOcupadoEmail",
      "value": "tecnico.ocupado@quickpatch.test",
      "type": "string"
    },
    {
      "key": "tecnicoOtroEmail",
      "value": "tecnico.otro@quickpatch.test",
      "type": "string"
    },
    {
      "key": "clienteEmail",
      "value": "cliente@quickpatch.test",
      "type": "string"
    },
    {
      "key": "passwordComun",
      "value": "",
      "type": "string"
    },
    {
      "key": "tecnicoToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "tecnicoOcupadoToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "tecnicoOtroToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "clienteToken",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "0. Autenticación y Tokens de Prueba",
      "item": [
        {
          "name": "0.1 Login Técnico Principal (usr-tec-01)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Correlation-Id",
                "value": "{{$guid}}"
              },
              {
                "key": "X-Channel-Id",
                "value": "quickpatch-mobile"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{tecnicoEmail}}\",\n  \"password\": \"{{passwordComun}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('[Auth] Login técnico exitoso (200 OK)', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('tecnicoToken', pm.response.json().accessToken);"
