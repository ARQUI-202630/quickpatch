    {
      "name": "1. SCRUM-90 — Disponibilidad y Cobertura (Matching Service)",
      "item": [
        {
          "name": "1.1 [COV-001] Catálogo público de 20 localidades oficiales de Bogotá",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Correlation-Id",
                "value": "{{$guid}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/localities",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "localities"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('[SCRUM-90] 200 OK en listado de localidades', () => pm.response.to.have.status(200));",
                  "const locs = pm.response.json();",
                  "pm.test('[Localidades] Devuelve exactamente las 20 localidades oficiales de Bogotá', () => pm.expect(locs.length).to.equal(20));",
                  "pm.test('[Localidades] Códigos oficiales 01 a 20 presentes', () => {",
                  "  pm.expect(locs[0].code).to.equal('01');",
                  "  pm.expect(locs[0].name).to.equal('Usaquén');",
                  "  pm.expect(locs[1].code).to.equal('02');",
                  "  pm.expect(locs[1].name).to.equal('Chapinero');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "1.2 [AVA-001] Consulta de disponibilidad inicial del técnico",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Correlation-Id",
                "value": "{{$guid}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{tecnicoToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/technicians/me/availability",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "technicians",
                "me",
                "availability"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('[SCRUM-90] 200 OK en consulta de disponibilidad', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('[Contrato] Atributos de disponibilidad presentes', () => {",
                  "  pm.expect(body).to.have.property('status');",
                  "  pm.expect(body).to.have.property('available');",
                  "  pm.expect(body).to.have.property('busy');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "1.3 [AVA-002] Cambiar disponibilidad a disponible (RF-13, RN-M10)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Correlation-Id",
                "value": "{{$guid}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{tecnicoToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/technicians/me/availability",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "technicians",
                "me",
                "availability"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"disponible\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('[SCRUM-90] 200 OK al actualizar disponibilidad', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('[SCRUM-90] Estado actualizado a disponible', () => pm.expect(body.status).to.equal('disponible'));",
                  "pm.test('[SCRUM-90] Flag available es true', () => pm.expect(body.available).to.be.true);",
                  "pm.test('[SCRUM-90] Flag busy es false', () => pm.expect(body.busy).to.be.false);"
                ]
              }
            }
          ]
        },
        {
          "name": "1.4 [AVA-003] Rechazo de cambio manual si técnico está ocupado en servicio (RN-M6)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Correlation-Id",
                "value": "{{$guid}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{tecnicoOcupadoToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/technicians/me/availability",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "technicians",
                "me",
                "availability"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"no_disponible\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('[SCRUM-90 / RN-M6] 409 Conflict si técnico está ocupado', () => pm.response.to.have.status(409));",
                  "pm.test('[RFC 9457] Problem Details con correlationId', () => {",
                  "  pm.expect(pm.response.headers.get('Content-Type')).to.include('application/problem+json');",
                  "  pm.expect(pm.response.json()).to.have.property('correlationId');",
                  "});",
                  "pm.test('[Contrato] Tipo de error transicion-invalida', () => pm.expect(pm.response.json().type).to.match(/\\/transicion-invalida$/));"
                ]
              }
            }
          ]
        },
        {
          "name": "1.5 [COV-002] Consulta de cobertura inicial del técnico",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Correlation-Id",
                "value": "{{$guid}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{tecnicoToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/technicians/me/coverage",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "technicians",
                "me",
                "coverage"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('[SCRUM-90] 200 OK en consulta de cobertura', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('[Contrato] Atributo localityCodes es array', () => pm.expect(body.localityCodes).to.be.an('array'));"
                ]
              }
            }
          ]
        },
        {
          "name": "1.6 [COV-003] Configuración de cobertura geográfica por localidades (RF-13)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Correlation-Id",
                "value": "{{$guid}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{tecnicoToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/technicians/me/coverage",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "technicians",
                "me",
                "coverage"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"localityCodes\": [\n    \"01\",\n    \"02\",\n    \"12\",\n    \"13\"\n  ]\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('[SCRUM-90] 200 OK al actualizar cobertura', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('[SCRUM-90] Localidades configuradas correctamente', () => {",
                  "  pm.expect(body.localityCodes).to.include('01');",
                  "  pm.expect(body.localityCodes).to.include('02');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "1.7 [COV-004] Rechazo de cobertura vacía o con código inexistente",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Correlation-Id",
                "value": "{{$guid}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{tecnicoToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/technicians/me/coverage",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "technicians",
                "me",
                "coverage"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"localityCodes\": [\n    \"99\"\n  ]\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('[SCRUM-90] 400 Bad Request ante código inexistente', () => pm.response.to.have.status(400));",
                  "pm.test('[RFC 9457] Problem Details con correlationId', () => {",
                  "  pm.expect(pm.response.headers.get('Content-Type')).to.include('application/problem+json');",
                  "  pm.expect(pm.response.json()).to.have.property('correlationId');",
                  "});",
                  "pm.test('[Contrato] Tipo de error validacion-solicitud', () => pm.expect(pm.response.json().type).to.match(/\\/validacion-solicitud$/));"
                ]
              }
            }
          ]
        },
        {
          "name": "1.8 [AVA-004] Rechazo de consulta sin token → 401 Unauthorized",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Correlation-Id",
                "value": "{{$guid}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/technicians/me/availability",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "technicians",
                "me",
                "availability"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('[Seguridad] 401 Unauthorized sin token', () => pm.response.to.have.status(401));",
                  "pm.test('[RFC 9457] Problem Details con correlationId', () => {",
                  "  pm.expect(pm.response.headers.get('Content-Type')).to.include('application/problem+json');",
                  "  pm.expect(pm.response.json()).to.have.property('correlationId');",
                  "});",
                  "pm.test('[Contrato] Tipo de error no-autenticado', () => pm.expect(pm.response.json().type).to.match(/\\/no-autenticado$/));"
                ]
              }
            }
          ]
        },
        {
          "name": "1.9 [AVA-005] Control RBAC: Rol cliente no puede gestionar disponibilidad → 403 Forbidden",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Correlation-Id",
                "value": "{{$guid}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{clienteToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/technicians/me/availability",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "technicians",
                "me",
                "availability"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"disponible\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('[RBAC] 403 Forbidden para rol cliente', () => pm.response.to.have.status(403));",
                  "pm.test('[RFC 9457] Problem Details con correlationId', () => {",
                  "  pm.expect(pm.response.headers.get('Content-Type')).to.include('application/problem+json');",
                  "  pm.expect(pm.response.json()).to.have.property('correlationId');",
                  "});",
                  "pm.test('[Contrato] Tipo de error no-autorizado', () => pm.expect(pm.response.json().type).to.match(/\\/no-autorizado$/));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. SCRUM-81 — Aceptación y Rechazo de Ofertas (Matching Service)",
      "item": [
        {
          "name": "2.1 [OFF-001] Consultar ofertas pendientes (sin dirección exacta, RN-SR13)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Correlation-Id",
                "value": "{{$guid}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{tecnicoToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/matching/offers?status=pendiente",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "matching",
                "offers?status=pendiente"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('[SCRUM-81] 200 OK en consulta de ofertas', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('[SCRUM-81] Lista de ofertas con al menos un elemento', () => pm.expect(body.items.length).to.be.above(0));",
                  "const oferta = body.items[0];",
                  "pm.test('[RN-SR13] Oferta contiene localidad y distancia pero NO dirección exacta', () => {",
                  "  pm.expect(oferta).to.have.property('locality');",
                  "  pm.expect(oferta).to.have.property('distanceM');",
                  "  pm.expect(oferta).to.have.property('description');",
                  "  pm.expect(oferta).to.not.have.property('addressText');",
                  "  pm.expect(oferta).to.not.have.property('address');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "2.2 [OFF-002] Aceptar oferta legítima (Atómica: ocupado, asignado, Outbox)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Correlation-Id",
                "value": "{{$guid}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{tecnicoToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/matching/offers/attempt-valid-01/accept",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "matching",
                "offers",
                "attempt-valid-01",
                "accept"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('[SCRUM-81] 200 OK al aceptar oferta legítima', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('[SCRUM-81] Respuesta es aceptado', () => pm.expect(body.response).to.equal('aceptado'));",
                  "pm.test('[SCRUM-81] Atributos de respuesta presentes', () => {",
                  "  pm.expect(body).to.have.property('attemptId');",
                  "  pm.expect(body).to.have.property('serviceRequestId');",
                  "  pm.expect(body).to.have.property('assignedAt');",
                  "});"
                ]
              }
            }
          ]
