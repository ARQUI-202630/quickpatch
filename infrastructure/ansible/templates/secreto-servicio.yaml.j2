{# Communication tiene base propia desde el DD V5 (buzón de notificaciones, ADR-024): conexiones del migrator y del app, más la llave pública. #}
{# ServiceRequest guarda además la llave de Garage `service-request`, que solo ve el bucket de evidencias (SCRUM-94). #}
{# Y la clave de su usuario de Redis, que coordina el vencimiento de las cotizaciones (SCRUM-488). #}
{# Matching guarda las contraseñas por separado y también la llave pública; sin ella sus endpoints con token responden 401. #}
{# Secret de un servicio (item) para el primer despliegue. Las claves son las que documenta deploy/k8s/README.md de cada #}
{# servicio. Sale por la entrada estándar de kubectl: ningún valor secreto aparece en la línea de comandos. #}
apiVersion: v1
kind: Secret
metadata:
  name: {{ item | replace('_', '-') }}-secretos
  namespace: quickpatch
type: Opaque
stringData:
{% if item == 'matching' %}
  app-password: "{{ e.pw[item].app }}"
  migrator-password: "{{ e.pw[item].migrator }}"
  jwt-public-key: |
{{ jwt.public | indent(4, true) }}
{% else %}
  migrator-connection: "Host={{ e.datos }};Port=5432;Database=db_{{ item }};Username={{ item }}_migrator;Password={{ e.pw[item].migrator }}"
  app-connection: "Host={{ e.datos }};Port=5432;Database=db_{{ item }};Username={{ item }}_app;Password={{ e.pw[item].app }};Maximum Pool Size={{ pool_conexiones[item] | default(20) }}"
{% if item == 'identity' %}
  jwt-private-key: |
{{ jwt.private | indent(4, true) }}
  admin-email: "{{ admins.admin_email }}"
  admin-password: "{{ admins.admin_password }}"
  platform-admin-email: "{{ admins.platform_email }}"
  platform-admin-password: "{{ admins.platform_password }}"
{% else %}
  jwt-public-key: |
{{ jwt.public | indent(4, true) }}
{% endif %}
{% if item == 'service_request' %}
  garage-access-key: "{{ e.garage.id }}"
  garage-secret-key: "{{ e.garage.secret }}"
  redis-password: "{{ e.redis }}"
{% endif %}
{% endif %}
